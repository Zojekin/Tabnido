{
  "name": "tabnido",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "audit:dist": "node scripts/audit.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run audit:dist",
    "pack": "node scripts/pack.mjs",
    "ship": "npm run check && npm run pack",
    "format": "prettier --write src tests scripts public *.json *.html *.ts *.md",
    "format:check": "prettier --check src tests scripts public *.json *.html *.ts *.md"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
